rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Multi-tenant organization isolation rule
    match /organizations/{organizationId}/contracts/{contractId}/{documentFile} {
      allow read, write: if request.auth != null && 
        (request.auth.token.organization_id == organizationId || request.auth.token.admin == true);
    }
  }
}
